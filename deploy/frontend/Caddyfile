:{$PORT:8080} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	handle /healthz {
		respond 200
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:http://api.railway.internal:8080}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
