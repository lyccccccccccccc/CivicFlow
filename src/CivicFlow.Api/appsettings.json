{
  "DatabaseMigration": {
    "AutoMigrate": false,
    "EnableLegacyBaselineRegistration": false,
    "ApplyPhase2UpgradeBeforeBaseline": false
  },
  "FileStorage": {
    "ContainerName": "case-attachments",
    "UseManagedIdentity": true,
    "SoftDeleteRetentionDays": 30
  },
  "Jwt": {
    "Issuer": "CivicFlow",
    "Audience": "CivicFlow.Client",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
